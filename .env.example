# ═══════════════════════════════════════════════════════════
# 🐉🔥 DrogonClaw Configuration
# ═══════════════════════════════════════════════════════════
#
# DrogonClaw is configured through its Setup Wizard, NOT by exporting
# environment variables. Run `./drogonclaw setup` (or `/setup` inside the
# terminal) and your choices are written to ~/.drogonclaw/config.json
# (owner read/write only).
#
# The variables below are ONLY optional env-var overrides that take precedence
# over the saved config file. You do not need to set any of them — use the
# wizard instead. Copy this file to `.env` and adjust only if you prefer to
# drive configuration from the environment.

# ─── AI Provider Configuration ────────────────────────────
# Supported providers: openrouter (default), nvidia, openai, gemini, ollama
AI_PROVIDER=openrouter

# Model is set with a single key regardless of provider.
# Defaults to meta-llama/llama-3.1-70b-instruct when unset.
AI_MODEL=meta-llama/llama-3.1-70b-instruct

# OpenRouter (default provider) — multi-model gateway
OPENROUTER_API_KEY=your_openrouter_api_key_here

# NVIDIA NIM — high-performance inference (Nemotron, Qwen, DeepSeek, Llama)
NVIDIA_API_KEY=your_nvidia_api_key_here

# OpenAI — direct API runtime (gpt-4o, gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini — enterprise reasoning core (gemini-2.5-pro, gemini-2.5-flash)
GOOGLE_API_KEY=your_google_api_key_here

# Ollama (Local Models) — autonomous offline runtime
OLLAMA_BASE_URL=http://localhost:11434

# ─── Sandbox Execution ────────────────────────────────────
# Tools run in an isolated ephemeral Docker sandbox by default. Set to "false"
# to fall back to the host shell (the engine fails closed otherwise).
USE_SANDBOX=true

# ─── Telegram Bot Configuration (Remote C2 Gateway) ──────
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── OSINT / Recon API Keys ─────────────────────────────
# GitHub token (optional): enables authenticated code + repository search for
# secret/credential leak hunting. Falls back to passive dorking when unset.
GITHUB_TOKEN=
SHODAN_API_KEY=your_shodan_api_key_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here
HUNTER_IO_API_KEY=your_hunter_io_api_key_here
EXA_API_KEY=your_exa_api_key_here

# ─── Local API Authentication ────────────────────────────
# Optional static Bearer token for the local control-plane API.
DROGONCLAW_API_KEY=your_local_api_token_here

# ─── Operator / Agent Identity ───────────────────────────
OPERATOR_NAME=Operator
AGENT_NAME=DrogonClaw
